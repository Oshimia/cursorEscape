{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog/schema/v1.json",
  "title": "Procedure registry catalog v1",
  "type": "object",
  "required": ["schema", "kind", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "catalog/v1" },
    "kind": { "enum": ["agents", "rules", "skills", "workflows"] },
    "items": { "type": "array", "items": { "type": "object" } },
    "compositions": { "type": "array", "items": { "$ref": "#/$defs/composition" } },
    "alwaysOn": { "type": "array", "items": { "$ref": "#/$defs/alwaysOnPolicy" } },
    "semanticOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "agents" } } },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/agentsItem" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "skills" } } },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/skillsItem" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "rules" } } },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/catalogItem" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "workflows" } } },
      "then": { "properties": { "items": { "items": { "$ref": "#/$defs/catalogItem" } } } }
    },
    {
      "if": { "not": { "properties": { "kind": { "const": "workflows" } }, "required": ["kind"] } },
      "then": { "properties": { "compositions": false, "semanticOrder": false, "alwaysOn": false } }
    }
  ],
  "$defs": {
    "repoPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\000-\\037]+$" },
    "host": { "enum": ["Cursor", "OpenCode", "Antigravity", "Vscode", "Cline", "Kilocode", "Codex"] },
    "catalogItem": {
      "type": "object",
      "required": ["id", "body"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "body": { "$ref": "#/$defs/repoPath" }
      }
    },
    "agentsItem": {
      "type": "object",
      "required": ["id", "body", "authority", "isolation", "loopGate", "failLoudShape", "requiredReading", "aliases", "hostBindings"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "body": { "$ref": "#/$defs/repoPath" },
        "authority": { "enum": ["read-only", "workspace-write"] },
        "isolation": { "const": "clean-context" },
        "loopGate": { "type": "string", "minLength": 1 },
        "failLoudShape": { "type": "string", "minLength": 1 },
        "requiredReading": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "hostBindings": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/agentBinding" } }
      }
    },
    "agentBinding": {
      "type": "object",
      "required": ["host", "representation", "routeIdentity", "alias", "launchMechanism", "authority", "isolation", "classification", "evidencePaths"],
      "additionalProperties": false,
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "representation": { "enum": ["native-definition", "generated-native-projection", "fallback-launch-contract", "missing"] },
        "routeIdentity": { "type": ["string", "null"] },
        "alias": { "type": ["string", "null"] },
        "launchMechanism": { "type": ["string", "null"] },
        "authority": { "type": ["string", "null"], "enum": [null, "read-only", "workspace-write", "read-only (sandbox_mode)", "workspace-write (sandbox_mode)"] },
        "isolation": { "type": ["string", "null"], "enum": [null, "clean-context", "fresh task/session per pass"] },
        "classification": { "type": ["string", "null"], "enum": [null, "host wrapper", "generated output", "intentional host deviation", "primary-mode definition", "fallback contract"] },
        "evidencePaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "skillsItem": {
      "type": "object",
      "required": ["id", "body", "description", "modelInvocationDisabled", "explicitOnly", "hostApplicability"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "body": { "$ref": "#/$defs/repoPath" },
        "description": { "$ref": "#/$defs/skillDescription" },
        "modelInvocationDisabled": { "type": "boolean" },
        "explicitOnly": { "type": "boolean" },
        "hostApplicability": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/skillBinding" } },
        "hostFrontmatterProfiles": { "type": "array", "items": { "$ref": "#/$defs/skillHostFrontmatterProfile" } }
      }
    },
    "skillDescription": {
      "type": "object",
      "required": ["style", "lines"],
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["folded-block", "plain-scalar"] },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "type": "string", "minLength": 1 },
              { "not": { "pattern": "^\\s|[\\r\\n\\t]|\\s$" } }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "style": { "const": "plain-scalar" } } },
          "then": { "properties": { "lines": { "maxItems": 1 } } }
        }
      ]
    },
    "skillBinding": {
      "type": "object",
      "required": ["host", "status", "evidencePaths"],
      "additionalProperties": false,
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "status": { "enum": ["applicable", "not-applicable"] },
        "evidencePaths": { "type": "array", "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "skillHostFrontmatterProfile": {
      "type": "object",
      "required": ["hosts", "wrapperSource", "description", "modelInvocationDisabled"],
      "additionalProperties": false,
      "properties": {
        "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/host" } },
        "wrapperSource": { "$ref": "#/$defs/repoPath" },
        "description": { "$ref": "#/$defs/skillDescription" },
        "modelInvocationDisabled": { "type": "boolean" }
      }
    },
    "composition": {
      "type": "object",
      "required": ["id", "host", "canonicalReferenceId", "references"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "host": { "$ref": "#/$defs/host" },
        "canonicalReferenceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "runtimeOnly": { "type": "boolean" }
      }
    },
    "alwaysOnPolicy": {
      "type": "object",
      "required": ["id", "host", "gate", "surface", "canonicalReferenceId", "evidencePaths"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "host": { "$ref": "#/$defs/alwaysOnHost" },
        "gate": { "enum": ["invocation", "plan-review", "code-review", "pre-commit"] },
        "surface": { "enum": ["cursor-hybrid-rule", "opencode-agents-dual-write", "opencode-skill", "antigravity-gemini", "antigravity-skill", "codex-managed-block"] },
        "canonicalReferenceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "evidencePaths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/repoPath" } }
      }
    },
    "alwaysOnHost": { "enum": ["Cursor", "OpenCode", "Codex", "Antigravity"] }
  }
}
